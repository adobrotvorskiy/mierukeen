#!/bin/sh
# mkeen — управление mieru + sing-box на Keenetic/Entware.
# Минимальный CLI в стиле xkeen.

PREFIX="/opt"
CONF="$PREFIX/etc/mkeen"
RUN="$PREFIX/var/run"
LOG="$PREFIX/var/log"
INIT="$PREFIX/etc/init.d/S99mkeen"
PROFILES="$CONF/profiles"
ACTIVE_LINK="$CONF/active"

SINGBOX_BIN="$PREFIX/sbin/sing-box"
MIERU_BIN="$PREFIX/sbin/mieru"

# upstream sing-box: SagerNet публикует готовый linux-mipsle-softfloat,
# годный для Keenetic → обновление sing-box не требует нашей CI-сборки.
# mieru здесь НЕ обновляется (upstream mipsle для него не выпускает —
# mieru идёт через релиз репы mierukeen).
SINGBOX_UPSTREAM="SagerNet/sing-box"

# cron-watchdog (строка ровно как в scripts/install.sh)
WD_MARKER="mierukeen-watchdog"
WD_LINE="* * * * * /opt/etc/init.d/S99mkeen check >/dev/null 2>&1 || /opt/etc/init.d/S99mkeen start >/dev/null 2>&1 # mierukeen-watchdog"

# /root read-only на Keenetic — mieru state кладём в /opt
export HOME="$PREFIX/etc/mkeen/.mieru-state"
mkdir -p "$HOME"

log()  { echo "[mkeen] $*"; }
die()  { echo "[mkeen] ERROR: $*" >&2; exit 1; }

active_profile() {
    if [ -L "$ACTIVE_LINK" ]; then
        basename "$(readlink "$ACTIVE_LINK")"
    else
        echo "default"
    fi
}

cmd_start()   { "$INIT" start;   }
cmd_stop()    { "$INIT" stop;    }
cmd_restart() { "$INIT" restart; }
cmd_status()  { "$INIT" status;  }

cmd_log() {
    case "$1" in
        mieru)   tail -F "$LOG/mieru.log"   ;;
        singbox) tail -F "$LOG/sing-box.log" ;;
        *)       tail -F "$LOG/mieru.log" "$LOG/sing-box.log" ;;
    esac
}

cmd_profile() {
    sub="$1"; shift
    case "$sub" in
        list)
            cur="$(active_profile)"
            for p in "$PROFILES"/*/; do
                [ -d "$p" ] || continue
                name="$(basename "$p")"
                if [ "$name" = "$cur" ]; then
                    echo "* $name"
                else
                    echo "  $name"
                fi
            done
            ;;
        use)
            name="$1"
            [ -d "$PROFILES/$name" ] || die "профиль не найден: $name"
            ln -sfn "$PROFILES/$name" "$ACTIVE_LINK"
            log "активирован профиль: $name"
            log "перезапусти: mkeen -restart"
            ;;
        show)
            name="${1:-$(active_profile)}"
            [ -d "$PROFILES/$name" ] || die "профиль не найден: $name"
            echo "── $name ──"
            for f in mieru.json singbox.json; do
                echo "─── $f ───"
                cat "$PROFILES/$name/$f" 2>/dev/null || echo "(нет)"
            done
            ;;
        add)
            name="$1"
            [ -n "$name" ] || die "usage: mkeen profile add <name>"
            [ ! -d "$PROFILES/$name" ] || die "уже существует: $name"
            mkdir -p "$PROFILES/$name"
            cp "$PROFILES/default/mieru.json"   "$PROFILES/$name/mieru.json"
            cp "$PROFILES/default/singbox.json" "$PROFILES/$name/singbox.json"
            log "создан профиль: $name"
            log "отредактируй: $PROFILES/$name/{mieru,singbox}.json"
            ;;
        rm)
            name="$1"
            [ -n "$name" ] || die "usage: mkeen profile rm <name>"
            [ "$name" != "default" ] || die "default удалять нельзя"
            [ "$name" != "$(active_profile)" ] || die "нельзя удалить активный профиль"
            rm -rf "$PROFILES/$name"
            log "удалён профиль: $name"
            ;;
        *)
            echo "usage: mkeen profile {list|use <name>|show [name]|add <name>|rm <name>}"
            exit 1
            ;;
    esac
}

# ── routes ───────────────────────────────────────────────────────────
# Правила пишутся прямо в singbox.json активного профиля. Каждое
# user-правило помечается полем "_mkeen_user": true — это позволяет
# find/remove. Pattern с "/" трактуется как CIDR, иначе как domain_suffix.
# Маппинг dest: proxy→mieru-out, direct→direct, block→block.
cmd_route() {
    command -v jq >/dev/null 2>&1 || die "нужен jq (opkg install jq)"
    sub="$1"; shift
    cfg="$PROFILES/$(active_profile)/singbox.json"
    [ -f "$cfg" ] || die "нет $cfg"

    case "$sub" in
        add)
            pattern="$1"; dest="$2"
            [ -n "$pattern" ] && [ -n "$dest" ] || \
                die "usage: mkeen route add <domain|cidr> <proxy|direct|block>"
            case "$dest" in
                proxy)  outbound=mieru-out ;;
                direct) outbound=direct ;;
                block)  outbound=block ;;
                *)      die "dest: proxy|direct|block" ;;
            esac
            if echo "$pattern" | grep -q '/'; then
                rule_key=ip_cidr
            else
                rule_key=domain_suffix
            fi
            tmp="$(mktemp)"
            jq --arg p "$pattern" --arg k "$rule_key" --arg ob "$outbound" '
                .route.rules = ([{ "_mkeen_user": true, ($k): [$p], "outbound": $ob }] + .route.rules)
            ' "$cfg" > "$tmp" && mv "$tmp" "$cfg"
            log "+ $pattern ($rule_key) -> $dest"
            log "применить: mkeen route reload"
            ;;
        del)
            pattern="$1"
            [ -n "$pattern" ] || die "usage: mkeen route del <domain|cidr>"
            tmp="$(mktemp)"
            jq --arg p "$pattern" '
                .route.rules = [.route.rules[] | select(
                    (._mkeen_user // false | not)
                    or
                    (((.domain_suffix // []) + (.ip_cidr // [])) | index($p) | not)
                )]
            ' "$cfg" > "$tmp" && mv "$tmp" "$cfg"
            log "− $pattern"
            log "применить: mkeen route reload"
            ;;
        list)
            jq -r '
                .route.rules
                | map(select(._mkeen_user == true))
                | .[]
                | "  " + ((.domain_suffix // .ip_cidr // [])[0]) + " -> " + .outbound
            ' "$cfg"
            ;;
        reload)
            cmd_restart
            ;;
        *)
            echo "usage: mkeen route {add <pat> <proxy|direct|block>|del <pat>|list|reload}"
            exit 1
            ;;
    esac
}

# ── NDMS Policy ──────────────────────────────────────────────────────
# Привязка к NDMS-политике Keenetic: Keenetic ставит на пакеты
# устройств в политике fwmark, специфичный для этой политики.
# mark достаём из локального REST API (тот же, что использует web-UI).
cmd_ndms() {
    sub="$1"; shift
    policy_name_file="$CONF/policy_name"
    policy_mark_file="$CONF/policy_mark"
    default_name="Mierukeen"

    case "$sub" in
        detect)
            name="${1:-$(cat "$policy_name_file" 2>/dev/null || echo "$default_name")}"
            command -v jq >/dev/null 2>&1 || die "нужен jq (opkg install jq)"
            mark="$(curl -kfsS "http://localhost:79/rci/show/ip/policy" 2>/dev/null \
                    | jq -r --arg n "$name" '
                        .[] | select(.description | ascii_downcase == ($n | ascii_downcase)) | .mark
                      ' | head -1)"
            [ -n "$mark" ] && [ "$mark" != "null" ] || \
                die "политика '$name' не найдена в NDMS. Создай её в UI: Сетевые правила → Политики."
            echo "$name" > "$policy_name_file"
            echo "$mark"  > "$policy_mark_file"
            log "политика '$name' найдена, mark=0x$mark — сохранено"
            log "применить: mkeen -restart"
            ;;
        bind)
            mark="$1"
            [ -n "$mark" ] || die "usage: mkeen ndms bind <mark-hex>"
            mark="$(echo "$mark" | sed 's/^0x//' | tr 'A-F' 'a-f')"
            echo "$mark" > "$policy_mark_file"
            log "привязан mark=0x$mark"
            log "применить: mkeen -restart"
            ;;
        unbind)
            rm -f "$policy_mark_file"
            log "привязка снята (применить: mkeen -restart)"
            ;;
        status)
            name="$(cat "$policy_name_file" 2>/dev/null || echo "<не задано>")"
            mark="$(cat "$policy_mark_file" 2>/dev/null || echo "<не привязан>")"
            echo "policy_name: $name"
            echo "policy_mark: $mark"
            ;;
        *)
            cat <<EOF
usage:
  mkeen ndms detect [name]   найти mark политики по имени (default: Mierukeen)
  mkeen ndms bind <mark>     задать mark вручную (hex, например ffffaab)
  mkeen ndms unbind          снять привязку
  mkeen ndms status          показать текущее состояние
EOF
            exit 1
            ;;
    esac
}

cmd_update() {
    url="https://raw.githubusercontent.com/adobrotvorskiy/mierukeen/main/scripts/install.sh"
    log "перекачиваю install.sh и перезапускаю"
    curl -fsSL "$url" | sh -s -- --upgrade
}

# ── watchdog on/off ──────────────────────────────────────────────────
# Приостановить/вернуть cron-watchdog на время правок, чтобы он не звал
# start параллельно с рестартом (гонка каскадных рестартов).
wd_off() {
    crontab -l 2>/dev/null | grep -q "$WD_MARKER" || return 0
    crontab -l 2>/dev/null | grep -v "$WD_MARKER" | crontab -
    log "watchdog приостановлен"
}
wd_on() {
    crontab -l 2>/dev/null | grep -q "$WD_MARKER" && return 0
    ( crontab -l 2>/dev/null; echo "$WD_LINE" ) | crontab -
    log "watchdog возвращён"
}

# ── update-singbox ───────────────────────────────────────────────────
# Обновляет ТОЛЬКО бинарь sing-box напрямую с релизов SagerNet (без CI
# репы). Безопасно: два вората ДО подмены (бинарь стартует + sing-box
# check на текущем конфиге), затем watchdog off → бэкап → своп → рестарт
# → verify → авто-откат при неудаче → watchdog on. mieru не трогается.
#   mkeen update-singbox            # последняя версия
#   mkeen update-singbox 1.13.14    # конкретная версия
cmd_update_singbox() {
    command -v curl >/dev/null 2>&1 || die "нужен curl"
    command -v tar  >/dev/null 2>&1 || die "нужен tar"

    case "$(uname -m)" in
        mips|mipsel) sbarch="linux-mipsle-softfloat" ;;
        aarch64)     sbarch="linux-arm64" ;;
        armv7l)      sbarch="linux-armv7" ;;
        *)           die "не поддерживаемая архитектура: $(uname -m)" ;;
    esac

    ver="${1#v}"
    if [ -z "$ver" ]; then
        log "ищу последний релиз sing-box"
        ver="$(curl -fsSL "https://api.github.com/repos/$SINGBOX_UPSTREAM/releases/latest" \
            | tr ',' '\n' | grep -m1 '"tag_name"' \
            | sed -E 's/.*"v?([0-9.]+)".*/\1/')"
        [ -n "$ver" ] || die "не узнал последнюю версию — задай явно: mkeen update-singbox X.Y.Z"
    fi
    cur="$("$SINGBOX_BIN" version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    log "sing-box: ${cur:-?} -> $ver ($sbarch)"
    [ "$cur" = "$ver" ] && { log "уже $ver — нечего делать"; return 0; }

    tmp="$(mktemp -d "${TMPDIR:-/tmp}/mkeen-sb.XXXXXX")" || die "mktemp не сработал"
    tb="sing-box-${ver}-${sbarch}.tar.gz"
    url="https://github.com/$SINGBOX_UPSTREAM/releases/download/v${ver}/${tb}"

    # качаем через тоннель (socks 1080) — GitHub-CDN из РФ капризен; если
    # sock недоступен, фолбэк на прямой WAN.
    log "качаю $tb"
    if ! curl -fL --connect-timeout 8 --socks5-hostname 127.0.0.1:1080 "$url" -o "$tmp/$tb" 2>/dev/null; then
        log "через socks не вышло — пробую напрямую"
        curl -fL "$url" -o "$tmp/$tb" || { rm -rf "$tmp"; die "не скачался $tb"; }
    fi
    tar -xzf "$tmp/$tb" -C "$tmp" || { rm -rf "$tmp"; die "распаковка не удалась"; }
    new="$(find "$tmp" -name sing-box -type f 2>/dev/null | head -1)"
    [ -n "$new" ] && [ -f "$new" ] || { rm -rf "$tmp"; die "sing-box не найден в архиве"; }
    chmod +x "$new"

    # ── ВОРОТА (до любых изменений на боевом) ──
    "$new" version >/dev/null 2>&1 || { rm -rf "$tmp"; die "новый бинарь не запускается (арх/float mismatch)"; }
    cfg="$ACTIVE_LINK/singbox.json"
    if ! "$new" check -c "$cfg" 2>"$tmp/checkerr"; then
        sed 's/^/[check] /' "$tmp/checkerr" >&2
        rm -rf "$tmp"
        die "новый sing-box отверг $cfg — нужна миграция конфига. Апдейт отменён, боевое не тронуто."
    fi

    # ── деплой с откатом ──
    bak="$SINGBOX_BIN.bak-${cur:-unknown}"
    wd_off
    cp "$SINGBOX_BIN" "$bak" || { wd_on; rm -rf "$tmp"; die "бэкап не создался — прерываю"; }
    log "бэкап: $bak"
    cp "$new" "$SINGBOX_BIN" && chmod +x "$SINGBOX_BIN"
    rm -rf "$tmp"
    log "рестарт mkeen"
    "$INIT" restart >/dev/null 2>&1
    sleep 3
    if pidof sing-box >/dev/null 2>&1 && "$INIT" check >/dev/null 2>&1; then
        wd_on
        log "OK: sing-box ${cur:-?} → $ver. Откат при нужде: cp $bak $SINGBOX_BIN && mkeen -restart"
    else
        log "FAIL: sing-box не завёлся — откатываюсь на ${cur:-?}"
        cp "$bak" "$SINGBOX_BIN" && chmod +x "$SINGBOX_BIN"
        "$INIT" restart >/dev/null 2>&1
        wd_on
        die "откат выполнен (sing-box ${cur:-?}). Новый бинарь не поднялся — смотри mkeen -log singbox"
    fi
}

case "$1" in
    -start|start)     cmd_start ;;
    -stop|stop)       cmd_stop ;;
    -restart|restart) cmd_restart ;;
    -status|status)   cmd_status ;;
    -log|log)         shift; cmd_log "$@" ;;
    profile)          shift; cmd_profile "$@" ;;
    route)            shift; cmd_route "$@" ;;
    ndms)             shift; cmd_ndms "$@" ;;
    update)           cmd_update ;;
    update-singbox|-update-singbox) shift; cmd_update_singbox "$@" ;;
    ""|-h|--help|help)
        cat <<EOF
mkeen — mieru + sing-box на Keenetic

  mkeen -start | -stop | -restart | -status
  mkeen -log [mieru|singbox]
  mkeen profile list | use <name> | show [name] | add <name> | rm <name>
  mkeen route add <domain|cidr> <proxy|direct|block>
  mkeen route del <domain|cidr>
  mkeen route list | reload
  mkeen ndms detect [name] | bind <mark> | unbind | status
  mkeen update                    полный апдейт (mieru+sing-box) из релиза репы
  mkeen update-singbox [X.Y.Z]    быстрый апдейт ТОЛЬКО sing-box с upstream

Активный профиль: $(active_profile)
Конфиги:          $CONF
Логи:             $LOG
EOF
        ;;
    *) die "неизвестная команда: $1 (mkeen --help)" ;;
esac
